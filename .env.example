# API base URL (must end with /api/)
#
# Physical Android phone (same WiFi as PC):
#   php artisan serve --host=0.0.0.0 --port=8001
#   BASE_URL=http://YOUR_PC_LAN_IP:8001/api/
#
# Android emulator:
#   php artisan serve
#   BASE_URL=http://10.0.2.2:8001/api/
BASE_URL=http://192.168.100.118:8001/api/
